# validation/.env.example — placeholders only. Never commit a real value.
#
# Copy to validation/.env (git-ignored) and fill in locally.
# SOLANA_RPC_URL must be HTTPS. A public endpoint is acceptable for smoke tests
# only; it is not a production capacity assumption.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
#
# Premium RPC endpoints usually carry the key in the query string, e.g.
#   https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE
# Every log and report path runs through validation/bin/redact.py first, so the
# key is replaced with [REDACTED] before anything is written to disk.
#
# Optional: override DEX Screener base URL for a documented mirror.
# DEXSCREENER_BASE_URL=https://api.dexscreener.com
#
# Optional: a mint already verified independently (never inferred from a ticker).
# MINT_VALID=So11111111111111111111111111111111111111112
#
# Run identifier prefix; a random suffix is appended per execution.
RUN_ID_PREFIX=pre5
#
# Sampling window for discover/scan; read-only, no transaction is ever built.
RATE_LIMIT_PAUSE_SECONDS=0.5